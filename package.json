{
  "name": "tweet-toaster",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.mjs",
    "start": "node src/index.mjs",
    "templates:sync": "node scripts/import-toast-templates.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "test:webkit": "node --test --test-concurrency=1 test/webkit.mjs",
    "test:live": "node --test test/live-provider.mjs"
  },
  "dependencies": {
    "playwright-core": "1.62.0"
  }
}
